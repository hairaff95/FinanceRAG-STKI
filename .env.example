# ==============================================================================
# KONFIGURASI SUPABASE CLOUD (FIN-CRAG)
# Dapatkan kredensial ini di: https://app.supabase.com -> Project Settings -> API
# ==============================================================================

# URL Project Supabase (Diperlukan di Vercel dan Local)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Kunci Anon Publik (Diperlukan di Vercel dan Local untuk membaca korpus)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Kunci Service Role (HANYA digunakan di lokal untuk menjalankan script: node scripts/sync_to_supabase.js)
# JANGAN pernah ekspos kunci ini ke publik atau front-end!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
